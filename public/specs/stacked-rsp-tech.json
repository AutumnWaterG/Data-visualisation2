{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Technology type mix per internet service provider, MBA Report 28.",
  "width": "container",
  "height": 320,
  "data": {
    "url": "data/mba-rsp-tech.json"
  },
  "mark": {
    "type": "bar"
  },
  "encoding": {
    "x": {
      "field": "rsp",
      "type": "nominal",
      "title": "Internet Service Provider",
      "sort": {
        "field": "count",
        "op": "sum",
        "order": "descending"
      },
      "axis": {
        "labelAngle": -35,
        "labelLimit": 160,
        "labelFontSize": 11
      }
    },
    "y": {
      "field": "count",
      "type": "quantitative",
      "title": "Number of Panel Services",
      "stack": "normalize",
      "axis": {
        "format": "%",
        "title": "Share of services (%)"
      }
    },
    "color": {
      "field": "technology",
      "type": "nominal",
      "scale": {
        "domain": [
          "Fibre to the Premises",
          "Hybrid Fibre Coaxial",
          "Fibre to the Curb",
          "Fibre to the Node",
          "Fixed Wireless",
          "Satellite"
        ],
        "range": [
          "#1565c0",
          "#1976d2",
          "#42a5f5",
          "#78909c",
          "#f57c00",
          "#bf360c"
        ]
      },
      "legend": {
        "title": "Technology",
        "orient": "bottom"
      }
    },
    "tooltip": [
      {
        "field": "rsp",
        "type": "nominal",
        "title": "Provider"
      },
      {
        "field": "technology",
        "type": "nominal",
        "title": "Technology"
      },
      {
        "field": "count",
        "type": "quantitative",
        "title": "Services"
      }
    ]
  },
  "config": {
    "background": "transparent",
    "view": {
      "stroke": "transparent"
    }
  }
}