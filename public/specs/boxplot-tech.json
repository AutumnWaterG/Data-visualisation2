{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Distribution of busy hour download speeds by technology, MBA Report 28.",
  "width": "container",
  "height": 320,
  "data": {
    "url": "data/mba-boxplot.json"
  },
  "mark": {
    "type": "boxplot",
    "extent": "min-max",
    "median": {
      "color": "white",
      "strokeWidth": 2
    },
    "box": {
      "size": 40
    }
  },
  "encoding": {
    "x": {
      "field": "technology",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "speed",
        "op": "median",
        "order": "descending"
      },
      "axis": {
        "labelAngle": -35,
        "labelAlign": "right",
        "labelLimit": 200,
        "labelPadding": 8,
        "labelFontSize": 11
      }
    },
    "y": {
      "field": "speed",
      "type": "quantitative",
      "title": "Busy Hour Download Speed (Mbps)",
      "scale": {
        "type": "log",
        "base": 10,
        "nice": true
      },
      "axis": {
        "values": [10, 25, 50, 100, 250, 500, 1000],
        "format": "~s"
      }
    },
    "color": {
      "field": "technology",
      "type": "nominal",
      "scale": {
        "domain": [
          "Fibre to the Premises",
          "Hybrid Fibre Coaxial",
          "Fibre to the Curb",
          "Fibre to the Node",
          "Fixed Wireless",
          "Satellite"
        ],
        "range": [
          "#1565c0",
          "#1976d2",
          "#42a5f5",
          "#78909c",
          "#f57c00",
          "#e53935"
        ]
      },
      "legend": null
    },
    "tooltip": [
      {
        "field": "technology",
        "type": "nominal",
        "title": "Technology"
      },
      {
        "field": "speed",
        "type": "quantitative",
        "title": "Speed (Mbps)",
        "format": ".1f"
      }
    ]
  },
  "padding": {"top": 5, "right": 5, "bottom": 65, "left": 5},
  "config": {
    "background": "transparent",
    "view": {
      "stroke": "transparent"
    }
  }
}