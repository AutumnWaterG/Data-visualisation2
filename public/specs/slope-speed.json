{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Slope graph comparing mean advertised vs mean actual speed per technology, showing which technologies over- or under-deliver, MBA Report 28.",
  "width": "container",
  "height": 340,
  "data": {"url": "data/mba-scatter.json"},
  "transform": [
    {
      "aggregate": [
        {"op": "mean", "field": "tier_mbps",   "as": "Advertised"},
        {"op": "mean", "field": "actual_mbps", "as": "Actual"}
      ],
      "groupby": ["technology"]
    },
    {"fold": ["Advertised", "Actual"], "as": ["Speed Type", "speed"]}
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.5,
        "point": {"filled": true, "size": 70}
      },
      "encoding": {
        "x": {
          "field": "Speed Type",
          "type": "ordinal",
          "title": null,
          "sort": ["Advertised", "Actual"],
          "axis": {"labelFontSize": 13, "labelFontWeight": "bold", "tickSize": 0}
        },
        "y": {
          "field": "speed",
          "type": "quantitative",
          "title": "Mean speed (Mbps)",
          "scale": {"zero": false}
        },
        "color": {
          "field": "technology",
          "type": "nominal",
          "scale": {
            "domain": ["Fibre to the Premises", "Hybrid Fibre Coaxial", "Fibre to the Curb", "Fibre to the Node", "Fixed Wireless", "Satellite"],
            "range": ["#1565c0", "#1976d2", "#42a5f5", "#78909c", "#f57c00", "#bf360c"]
          },
          "legend": null
        },
        "detail": {"field": "technology"},
        "tooltip": [
          {"field": "technology",  "type": "nominal",      "title": "Technology"},
          {"field": "Speed Type",  "type": "nominal",      "title": "Metric"},
          {"field": "speed",       "type": "quantitative", "title": "Mean speed (Mbps)", "format": ".1f"}
        ]
      }
    },
    {
      "transform": [{"filter": "datum['Speed Type'] === 'Actual'"}],
      "mark": {"type": "text", "align": "left", "dx": 8, "fontSize": 10.5, "fontWeight": 600},
      "encoding": {
        "x":    {"field": "Speed Type", "type": "ordinal", "sort": ["Advertised", "Actual"]},
        "y":    {"field": "speed", "type": "quantitative"},
        "text": {"field": "technology", "type": "nominal"},
        "color": {
          "field": "technology",
          "type": "nominal",
          "scale": {
            "domain": ["Fibre to the Premises", "Hybrid Fibre Coaxial", "Fibre to the Curb", "Fibre to the Node", "Fixed Wireless", "Satellite"],
            "range": ["#1565c0", "#1976d2", "#42a5f5", "#78909c", "#f57c00", "#bf360c"]
          }
        }
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {"stroke": "transparent"}
  }
}
