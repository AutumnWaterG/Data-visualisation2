{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Delivery performance categories by NBN technology — share of services exceeding, meeting, slightly under, or significantly under their advertised plan speed. MBA Report 28, 2025.",
  "width": "container",
  "height": 300,
  "data": {"url": "data/mba-scatter.json"},
  "transform": [
    {
      "calculate": "datum.actual_mbps / datum.tier_mbps",
      "as": "ratio"
    },
    {
      "calculate": "datum.ratio >= 1.1 ? 'Exceeds plan (110%+)' : datum.ratio >= 0.9 ? 'Meets plan (90–110%)' : datum.ratio >= 0.75 ? 'Slightly under (75–90%)' : 'Under-delivers (<75%)'",
      "as": "category"
    }
  ],
  "mark": {"type": "bar"},
  "encoding": {
    "x": {
      "field": "technology",
      "type": "nominal",
      "title": "NBN Technology",
      "sort": [
        "Fibre to the Premises",
        "Hybrid Fibre Coaxial",
        "Fibre to the Curb",
        "Fibre to the Node",
        "Fixed Wireless",
        "Satellite"
      ],
      "axis": {"labelAngle": -20, "labelLimit": 160}
    },
    "y": {
      "aggregate": "count",
      "type": "quantitative",
      "stack": "normalize",
      "title": "Share of services (%)",
      "axis": {"format": "%"}
    },
    "color": {
      "field": "category",
      "type": "nominal",
      "scale": {
        "domain": [
          "Exceeds plan (110%+)",
          "Meets plan (90–110%)",
          "Slightly under (75–90%)",
          "Under-delivers (<75%)"
        ],
        "range": ["#1565c0", "#64b5f6", "#f57c00", "#bf360c"]
      },
      "legend": {
        "title": "Delivery vs advertised plan",
        "orient": "bottom",
        "columns": 2,
        "labelFontSize": 11
      }
    },
    "order": {
      "field": "category",
      "type": "nominal",
      "sort": [
        "Exceeds plan (110%+)",
        "Meets plan (90–110%)",
        "Slightly under (75–90%)",
        "Under-delivers (<75%)"
      ]
    },
    "tooltip": [
      {"field": "technology", "type": "nominal", "title": "Technology"},
      {"field": "category", "type": "nominal", "title": "Delivery performance"},
      {"aggregate": "count", "type": "quantitative", "title": "Services in group"}
    ]
  },
  "config": {
    "background": "transparent",
    "view": {"stroke": "transparent"}
  }
}
